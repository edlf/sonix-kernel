config BCMDHD_101_10_361
	tristate "Broadcom 101.10.361.x FullMAC wireless cards support"
	---help---
	  This module adds support for wireless adapters based on
	  Broadcom FullMAC chipset.

config BCMDHD_101_10_361_FW_PATH
	depends on BCMDHD_101_10_361
	string "Firmware path"
	default "/lib/firmware/fw_bcm43013c1_ag.bin"
	---help---
	  Path to the firmware file.

config BCMDHD_101_10_361_NVRAM_PATH
	depends on BCMDHD_101_10_361
	string "NVRAM path"
	default "/lib/firmware/nvram_ap6203bm.txt"
	---help---
	  Path to the calibration file.

config BCMDHD_101_10_361_WEXT
	bool "Enable WEXT support"
	depends on BCMDHD_101_10_361 && CFG80211 = n
	select WIRELESS_EXT
	select WEXT_PRIV
	help
	  Enables WEXT support

choice
	prompt "Enable Chip Interface"
	depends on BCMDHD_101_10_361
	---help---
		Enable Chip Interface.
config BCMDHD_101_10_361_SDIO
		bool "SDIO bus interface support"
		depends on BCMDHD_101_10_361 && MMC
config BCMDHD_101_10_361_PCIE
		bool "PCIe bus interface support"
		depends on BCMDHD_101_10_361 && PCI
config BCMDHD_101_10_361_USB
		bool "USB bus interface support"
		depends on BCMDHD_101_10_361 && USB
endchoice

choice
	depends on BCMDHD_101_10_361 && BCMDHD_101_10_361_SDIO
	prompt "Interrupt type"
	---help---
		Interrupt type
config BCMDHD_101_10_361_OOB
	depends on BCMDHD_101_10_361 && BCMDHD_101_10_361_SDIO
	bool "Out-of-Band Interrupt"
	---help---
		Interrupt from WL_HOST_WAKE.
config BCMDHD_101_10_361_SDIO_IRQ
	depends on BCMDHD_101_10_361 && BCMDHD_101_10_361_SDIO
	bool "In-Band Interrupt"
	---help---
	  Interrupt from SDIO DAT[1]
endchoice
