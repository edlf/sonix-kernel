comment "ingenic-cim sensor drivers"

config INGENIC_CIM_CAMERA_AR0144
	tristate "ar0144 support"
	depends on VIDEO_INGENIC_CIM && I2C
	help
	  This is a ar0144 video driver

config INGENIC_CIM_CAMERA_OV2735B
	tristate "ov2735b support"
