menuconfig FB_INGENIC
	tristate "Ingenic Framebuffer Driver"
	depends on FB
	select FB_CFB_FILLRECT
	select FB_CFB_COPYAREA
	select FB_CFB_IMAGEBLIT
	help
		LCD Driver for INGENIC

config FB_FORMAT_X8B8G8R8
        bool "FB_FORMAT_X8B8G8R8 for Android"
        depends on FB_INGENIC
        default n
        help
          Disable Vsync skip

config FB_VSYNC_SKIP_DISABLE
        bool "Disable Vsync skip"
        depends on FB_INGENIC
        help
          Disable Vsync skip

config FB_VSYNC_SKIP
        int "Vsync skip ratio[0..9]"
        depends on FB_INGENIC
        default 9
        help
          Vsync skip ratio

config FB_INGENIC_NR_FRAMES
	int "how many frames support"
	depends on FB_INGENIC
	default 3

config FB_INGENIC_NR_LAYERS
	int "how many layers support"
	depends on FB_INGENIC
	default 4

config FB_INGENIC_DEBUG
        bool "fb test for displaying color bar"
        depends on FB_INGENIC
        default n
        help
           fb test for displaying color bar in your board.

config ROT_INGENIC
	tristate "X2600 Rotator"
	depends on SOC_X2600
	depends on FB_INGENIC
        default y
	---help---
	  This is the image rotation function of the x2600 series chip.

config ROT_INGENIC_BUFS
	int "how many rot buf support"
	depends on ROT_INGENIC
	default 2

config SLCDC_CONTINUA
    tristate "SLCDC CONTINUA TRANFER"
    depends on FB_INGENIC
    default n

config SLCDC_USE_TE
	tristate "SLCDC USE TE SIGNAL"
	depends on FB_INGENIC
	default n

config SF_EPD_DRIVER
	tristate "EPD by software control using sdma"
	depends on FB_INGENIC
	default n

config FB_USING_CACHABLE
	tristate "FrameBuffer map to user space by cachable."
	depends on FB_INGENIC
	default n

config PANEL_READ_ID
        bool "lcd panel_read_id"
	depends on FB_INGENIC
	default y
	help
		 lcd panel read id.
if FB_INGENIC
source "$OUTSIDE_DRIVERS/drivers/video/fbdev/ingenic/spi_fb_v12/Kconfig"
source "$OUTSIDE_DRIVERS/drivers/video/fbdev/ingenic/fb_stage/Kconfig"
source "$OUTSIDE_DRIVERS/drivers/video/fbdev/ingenic/fb_stage_wip/Kconfig"
endif
